{
  "info": {
    "name": "Task Manager API",
    "description": "API collection for the Node/Express Task Manager",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Jane Doe\",\n    \"email\": \"jane@example.com\",\n    \"password\": \"password123\",\n    \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"jane@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Complete project setup\",\n    \"description\": \"Setup Express server, MongoDB, and Postman collection.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/task/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "task",
                ""
              ]
            }
          }
        },
        {
          "name": "Get My Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/task/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "task",
                ""
              ]
            }
          }
        },
        {
          "name": "Get All Tasks (Admin Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/task/all",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "task",
                "all"
              ]
            }
          }
        },
        {
          "name": "Get Task By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/task/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "task",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<paste-task-id-here>"
                }
              ]
            }
          }
        },
        {
          "name": "Update Task By ID",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Complete project setup (Updated)\",\n    \"description\": \"Finished adding the controllers\",\n    \"completed\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/task/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "task",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<paste-task-id-here>"
                }
              ]
            }
          }
        },
        {
          "name": "Toggle Task Completion",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/task/completed/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "task",
                "completed",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<paste-task-id-here>"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Task By ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/task/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "task",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<paste-task-id-here>"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ]
}